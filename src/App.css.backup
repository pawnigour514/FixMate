
/* =========================
   FIXMATE HOME PAGE
========================= */

.home-page {
  min-height: 100vh;
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 60px 40px;

  background:
    radial-gradient(circle at 10% 10%, #dbeafe, transparent 35%),
    radial-gradient(circle at 90% 90%, #e0f2fe, transparent 35%),
    #f8fafc;

  font-family: Arial, sans-serif;
}

.home-content {
  width: 100%;
  max-width: 1100px;

  text-align: center;
}


/* =========================
   FIXMATE LOGO
========================= */

.home-logo {
  margin: 0;

  font-size: 72px;
  font-weight: 800;

  letter-spacing: -3px;

  color: #2563eb;
}

.home-tagline {
  margin-top: 15px;
  margin-bottom: 65px;

  font-size: 23px;
  line-height: 1.5;

  color: #64748b;
}


/* =========================
   CONTINUE AS
========================= */

.home-content h2 {
  margin-bottom: 40px;

  font-size: 38px;
  font-weight: 700;

  color: #0f172a;
}


/* =========================
   ROLE CARDS
========================= */

.role-container {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 55px;

  max-width: 1000px;

  margin: 0 auto;
}

.role-card {
  min-height: 370px;

  padding: 50px 45px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  background: rgba(255, 255, 255, 0.95);

  border: 2px solid #e2e8f0;

  border-radius: 28px;

  text-decoration: none;
  color: inherit;

  box-shadow:
    0 20px 45px rgba(15, 23, 42, 0.10);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.role-card:hover {
  transform: translateY(-10px);

  border-color: #60a5fa;

  box-shadow:
    0 30px 60px rgba(15, 23, 42, 0.16);
}


/* =========================
   ICON
========================= */

.role-icon {
  width: 100px;
  height: 100px;

  margin-bottom: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #eff6ff;

  border-radius: 25px;

  font-size: 52px;
}


/* =========================
   CARD TITLE
========================= */

.role-card h3 {
  margin: 0 0 18px;

  font-size: 32px;
  font-weight: 700;

  color: #0f172a;
}


/* =========================
   CARD DESCRIPTION
========================= */

.role-card p {
  max-width: 360px;

  margin: 0 auto 30px;

  font-size: 18px;

  line-height: 1.7;

  color: #64748b;
}


/* =========================
   CARD BUTTON TEXT
========================= */

.role-card span {
  font-size: 18px;
  font-weight: 700;

  color: #2563eb;
}


/* =========================
   FOOTER
========================= */

.home-footer {
  margin-top: 65px;

  font-size: 17px;

  letter-spacing: 2px;

  color: #94a3b8;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 750px) {

  .home-page {
    padding: 40px 20px;
  }

  .home-logo {
    font-size: 55px;
  }

  .home-tagline {
    font-size: 18px;
    margin-bottom: 45px;
  }

  .home-content h2 {
    font-size: 30px;
    margin-bottom: 30px;
  }

  .role-container {
    grid-template-columns: 1fr;

    gap: 30px;
  }

  .role-card {
    min-height: 330px;
  }

}
/* =========================
   TECHNICIAN DASHBOARD
========================= */

.dashboard {
  min-height: 100vh;
  display: flex;
  background: #f8fafc;
  font-family: Arial, sans-serif;
}


/* =========================
   SIDEBAR
========================= */

.sidebar {
  width: 260px;
  min-height: 100vh;
  padding: 30px 20px;

  background: #0f172a;
  color: white;

  display: flex;
  flex-direction: column;
}

.sidebar h2 {
  margin: 0 0 40px;
  padding-left: 15px;

  font-size: 30px;
  color: #60a5fa;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sidebar nav a {
  padding: 15px 18px;

  border-radius: 10px;

  color: #cbd5e1;
  text-decoration: none;

  font-size: 17px;
  font-weight: 600;

  transition: 0.2s;
}

.sidebar nav a:hover {
  background: #1e293b;
  color: white;
}

.logout {
  margin-top: auto;

  padding: 14px;

  border: none;
  border-radius: 10px;

  background: #ef4444;
  color: white;

  font-size: 16px;
  font-weight: 600;

  cursor: pointer;
}

.logout:hover {
  background: #dc2626;
}


/* =========================
   MAIN CONTENT
========================= */

.main-content {
  flex: 1;

  padding: 45px;

  overflow-x: hidden;
}


/* =========================
   TOP HEADER
========================= */

.top-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 35px;
}

.top-header h1 {
  margin: 0 0 8px;

  font-size: 36px;
  color: #0f172a;
}

.top-header p {
  margin: 0;

  font-size: 17px;
  color: #64748b;
}

.technician-info {
  display: flex;
  align-items: center;
  gap: 15px;

  padding: 12px 18px;

  background: white;

  border-radius: 14px;

  box-shadow: 0 5px 20px rgba(15, 23, 42, 0.08);
}

.technician-info strong {
  font-size: 16px;
  color: #0f172a;
}

.technician-info p {
  margin-top: 4px;
  font-size: 14px;
}

.notification {
  font-size: 25px;
}


/* =========================
   STATISTICS
========================= */

.stats {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 22px;

  margin-bottom: 35px;
}

.stat-card {
  padding: 25px;

  background: white;

  border-radius: 18px;

  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);

  border: 1px solid #e2e8f0;
}

.stat-card p {
  margin: 0 0 12px;

  font-size: 16px;
  color: #64748b;
}

.stat-card h2 {
  margin: 0;

  font-size: 32px;
  color: #2563eb;
}


/* =========================
   DASHBOARD CARDS
========================= */

.cards {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 25px;
}

.card {
  padding: 30px;

  background: white;

  border-radius: 18px;

  border: 1px solid #e2e8f0;

  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
}

.card h3 {
  margin: 0 0 12px;

  font-size: 23px;

  color: #0f172a;
}

.card p {
  margin-bottom: 25px;

  font-size: 16px;
  line-height: 1.6;

  color: #64748b;
}

.card-button {
  display: inline-block;

  padding: 12px 18px;

  border-radius: 9px;

  background: #2563eb;
  color: white;

  text-decoration: none;

  font-size: 15px;
  font-weight: 600;
}

.card-button:hover {
  background: #1d4ed8;
}


/* =========================
   TECHNICIAN MOBILE
========================= */

@media (max-width: 900px) {

  .sidebar {
    width: 210px;
  }

  .main-content {
    padding: 30px;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .cards {
    grid-template-columns: 1fr;
  }
}


@media (max-width: 650px) {

  .dashboard {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
  }

  .sidebar nav {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .sidebar nav a {
    font-size: 14px;
  }

  .main-content {
    padding: 20px;
  }

  .top-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .stats {
    grid-template-columns: 1fr;
  }
}
/* =========================
   BETTER RESPONSIVE DASHBOARD
========================= */

@media (max-width: 1100px) {
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }
}


@media (max-width: 800px) {
  .dashboard {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    padding: 20px;
  }

  .sidebar h2 {
    margin-bottom: 20px;
  }

  .sidebar nav {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .sidebar nav a {
    padding: 10px 14px;
  }

  .logout {
    margin-top: 20px;
    width: 120px;
  }

  .main-content {
    width: 100%;
    padding: 25px;
  }
}


@media (max-width: 600px) {
  .top-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .technician-info {
    width: 100%;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .top-header h1 {
    font-size: 28px;
  }

  .main-content {
    padding: 18px;
  }
}
.verified-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 24px;
  height: 24px;

  margin-left: 8px;

  background: #2563eb;
  color: white;

  border-radius: 50%;

  font-size: 15px;
  font-weight: 700;

  vertical-align: middle;
}

.blue-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 20px;
  height: 20px;

  margin-right: 6px;

  background: #2563eb;
  color: white;

  border-radius: 50%;

  font-size: 12px;
  font-weight: 700;
}

.verification-approved {
  padding: 25px;
  margin-bottom: 30px;

  text-align: center;

  background: #f0fdf4;

  border: 2px solid #86efac;

  border-radius: 16px;
}

.verification-check {
  width: 70px;
  height: 70px;

  margin: 0 auto 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #22c55e;
  color: white;

  border-radius: 50%;

  font-size: 42px;
  font-weight: 700;
}

.verification-success {
  margin-top: 25px;
  padding: 20px;

  text-align: center;

  background: #eff6ff;

  border: 1px solid #93c5fd;

  border-radius: 14px;
}

.big-green-check {
  display: block;

  margin-bottom: 10px;

  font-size: 42px;
  font-weight: 700;

  color: #16a34a;
}
/* =========================
   PROFILE ONLINE / OFFLINE
========================= */

.online,
.offline {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  font-size: 16px;
  font-weight: 600;
}

.online {
  color: #16a34a;
}

.offline {
  color: #dc2626;
}

.online::first-letter,
.offline::first-letter {
  font-size: 18px;
}
